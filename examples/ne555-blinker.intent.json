{
  "version": 1,
  "title": "NE555 astable LED blinker",
  "comment": "Written by hand. Uses Timer:NE555P, a symbol outside the core catalogue, and a +9V rail. Standard astable: R1 from VCC to DISCH, R2 from DISCH to THRES, C1 from THRES/TRIG to ground, 10 nF on CONT. With R1 = 1k, R2 = 68k, C1 = 10uF the period is 0.693 x (R1 + 2 x R2) x C1, about 0.95 s.",
  "parts": [
    { "ref": "J1", "libId": "Connector_Generic:Conn_01x02", "value": "9V_IN", "group": "input" },
    { "ref": "R1", "libId": "Device:R", "value": "1k", "group": "timing" },
    { "ref": "R2", "libId": "Device:R", "value": "68k", "group": "timing" },
    { "ref": "C1", "libId": "Device:C_Polarized", "value": "10uF", "group": "timing" },
    { "ref": "U1", "libId": "Timer:NE555P", "value": "NE555P", "group": "timer" },
    { "ref": "C2", "libId": "Device:C", "value": "10nF", "group": "timer" },
    { "ref": "R3", "libId": "Device:R", "value": "470", "group": "output" },
    { "ref": "D1", "libId": "Device:LED", "value": "RED", "group": "output" }
  ],
  "nets": [
    { "name": "+9V", "pins": ["J1.1", "R1.1", "U1.8", "U1.4"] },
    { "name": "DISCH", "pins": ["R1.2", "R2.1", "U1.7"] },
    { "name": "THRES", "pins": ["R2.2", "C1.1", "U1.6", "U1.2"] },
    { "name": "CONT", "pins": ["U1.5", "C2.1"] },
    { "name": "OUT", "pins": ["U1.3", "R3.1"] },
    { "name": "LED_A", "pins": ["R3.2", "D1.2"] },
    { "name": "GND", "pins": ["J1.2", "C1.2", "U1.1", "C2.2", "D1.1"] }
  ],
  "noConnect": [],
  "hints": { "groupOrder": ["input", "timing", "timer", "output"] }
}
